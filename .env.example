# 복사해서 .env 로 쓴다. 환경 변수 이름 = CLASSFIT_ + Settings 필드명(대문자)
CLASSFIT_DATABASE_URL=postgresql+psycopg://localhost:5432/classfit_dev
CLASSFIT_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/classfit_test
CLASSFIT_ENABLE_DOCS=true
# 파일 저장 루트. 예: var.nosync/files (gitignore). 비워 두면 파일 기능만 501(미구성)
CLASSFIT_FILE_STORE_ROOT=
# 교육 문의 알림 수신 주소. 비워 두면 문의 접수만 501(미구성)
CLASSFIT_INQUIRY_NOTIFY_TO=
