#!/usr/bin/env bash
# push 전 관문. make verify · CI 와 같은 스크립트를 부른다. 시험(라이브 PG)은 CI 가 돈다.
# 회귀 시험·순서 검사 스크립트가 없으면 bash 가 실패해 push 를 막는다(건너뛰지 않는다).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
make editable-check   # iCloud 가 .pth 를 숨겨 편집 설치가 죽었으면 여기서 이름을 대며 멈춘다
export CLASSFIT_FORBIDDEN_TERMS_REQUIRED=1   # 금지 용어 목록 파일이 없으면 gate 실패(E8)
make gate
make lint
make lint-imports
bash .claude/hooks/test_hooks.sh     # 훅 회귀(E-2)
bash scripts/test_gate.sh            # gate 회귀: ruff·gate·hook 세 층, 음성 9 · 양성 3(E-6)
# master first-parent · 가지 커밋 순서(E-1). 1(위반)·127(파일 없음)은 막고, 2("못 쟀다")는 경고만(E10, 안내서 §6.11)
rc=0; bash scripts/check_task_order.sh || rc=$?
if [ "$rc" -eq 2 ]; then
  echo "pre-push: 경고 — check_task_order 가 못 쟀다(exit 2). push 는 계속한다"
elif [ "$rc" -ne 0 ]; then
  exit "$rc"
fi
make okf   # OKF 문서 정리 guard(r3 E9). Makefile 이 PyYAML 있는 venv 파이썬을 넘긴다
# 문서 구조 검사. push 전에는 외부 정본(기획/·시안/) sha 까지 잰다(r3 N8). 2("못 쟀다": git 저장소가 아니거나 master 참조 없음)는
# check_task_order 처럼 경고만(E10). 문서·외부 정본을 못 읽는 것은 위반(1)이라 막는다.
rc=0; CLASSFIT_REQUIRE_EXTERNAL=1 bash scripts/check_docs.sh || rc=$?
if [ "$rc" -eq 2 ]; then
  echo "pre-push: 경고 — check_docs 가 못 쟀다(exit 2: master 참조 없음 등). push 는 계속한다"
elif [ "$rc" -ne 0 ]; then
  exit "$rc"
fi
bash scripts/golden/check.sh   # golden 재추출 대조(r3 E9·N8). 시안이 바뀌거나 golden.json 을 손으로 고치면 막는다. node 없으면 미구성 exit 1
